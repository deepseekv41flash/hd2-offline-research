[Unit]
Description=HD2 stage-2 discovery backend (research mock, mode=@MODE@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hd2disc
Group=hd2disc
WorkingDirectory=/opt/hd2-discovery
Environment=PYTHONUNBUFFERED=1
@CAPS_AMBIENT@
@CAPS_BOUNDING@
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/hd2-discovery/state /opt/hd2-discovery/logs
ExecStart=@PYTHON@ -m tools.mockctl serve @SERVE_ARGS@
Restart=always
RestartSec=3
StandardOutput=append:/opt/hd2-discovery/logs/service.log
StandardError=append:/opt/hd2-discovery/logs/service.log

[Install]
WantedBy=multi-user.target

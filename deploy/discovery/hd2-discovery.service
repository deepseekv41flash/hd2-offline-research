[Unit]
Description=HD2 stage-2 discovery backend (research mock, multi-client lobby)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hd2disc
Group=hd2disc
WorkingDirectory=/opt/hd2-discovery
Environment=PYTHONUNBUFFERED=1
# 绑定 443 不需要 root：由 CAP_NET_BIND_SERVICE 授权
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/hd2-discovery/state /opt/hd2-discovery/logs
ExecStart=/opt/hd2-discovery/venv/bin/python -m tools.mockctl serve --profile profiles/coop-discovery.json
Restart=always
RestartSec=3
StandardOutput=append:/opt/hd2-discovery/logs/service.log
StandardError=append:/opt/hd2-discovery/logs/service.log

[Install]
WantedBy=multi-user.target
